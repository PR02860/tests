
package agent

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"os"
	"strings"
	"time"

	"git.bcbssc.com/InformationSystems/ocp_status/internal/auth"
	"git.bcbssc.com/InformationSystems/ocp_status/internal/collect"
	"git.bcbssc.com/InformationSystems/ocp_status/internal/payload"

	"github.com/spf13/cobra"
	"k8s.io/client-go/dynamic"
	"k8s.io/client-go/rest"
	"k8s.io/client-go/tools/clientcmd"
)


type runDependencies struct {
	collectPayload func(
		context.Context, string, string,
	) (payload.Payload, error)

	computeToken func(
		[]byte, string,
	) (string, error)

	httpClient *http.Client
}

func newRunCommand() *cobra.Command {
	return newRunCommandWithDeps(runDependencies{})
}

func newRunCommandWithDeps(deps runDependencies) *cobra.Command {
	var clusterID string
	var collectorURL string
	var thanosURL string
	var thanosToken string
	var agentVersion string
	var kubeconfig string

	cmd := &cobra.Command{
		Use:   "run",
		Short: "Collect cluster status and send it to the collector",
		Args:  cobra.NoArgs,

		RunE: func(cmd *cobra.Command, args []string) error {
			ctx := cmd.Context()

			key := []byte(os.Getenv("OCP_STATUS_HMAC_KEY"))

			if strings.TrimSpace(clusterID) == "" {
				return fmt.Errorf("cluster ID is required")
			}
			if strings.TrimSpace(collectorURL) == "" {
				return fmt.Errorf("collector URL is required")
			}
			if len(key) == 0 {
				return fmt.Errorf(
					"OCP_STATUS_HMAC_KEY is required",
				)
			}

			if deps.collectPayload == nil &&
				strings.TrimSpace(thanosURL) == "" {
				return fmt.Errorf("Thanos URL is required")
			}

			collector := deps.collectPayload
			if collector == nil {
				collector = func(
					ctx context.Context,
					id string,
					version string,
				) (payload.Payload, error) {
					config, err := loadKubernetesConfig(kubeconfig)
					if err != nil {
						return payload.Payload{}, fmt.Errorf(
							"configure Kubernetes client: %w", err,
						)
					}

					k8sClient, err := dynamic.NewForConfig(config)
					if err != nil {
						return payload.Payload{}, fmt.Errorf(
							"create Kubernetes client: %w", err,
						)
					}

					thanosClient := &collect.ThanosClient{
						BaseURL: thanosURL,
						Token:   thanosToken,
					}

					return collect.CollectWithThanos(
						ctx,
						k8sClient,
						thanosClient,
						id,
						version,
					)
				}
			}

			tokenComputer := deps.computeToken
			if tokenComputer == nil {
				tokenComputer = auth.ComputeToken
			}

			httpClient := deps.httpClient
			if httpClient == nil {
				httpClient = &http.Client{
					Timeout: 15 * time.Second,
				}
			}

			err := executeAgentRun(
				ctx,
				collector,
				tokenComputer,
				httpClient,
				clusterID,
				agentVersion,
				collectorURL,
				key,
			)
			if err != nil {
				return fmt.Errorf("agent run failed: %w", err)
			}

			cmd.Println("Cluster status payload sent successfully")
			return nil
		},
	}

	cmd.Flags().StringVar(
		&clusterID,
		"cluster-id",
		os.Getenv("OCP_STATUS_CLUSTER_ID"),
		"OpenShift cluster identifier",
	)

	cmd.Flags().StringVar(
		&collectorURL,
		"collector-url",
		os.Getenv("OCP_STATUS_COLLECTOR_URL"),
		"Collector receiving endpoint URL",
	)

	cmd.Flags().StringVar(
		&thanosURL,
		"thanos-url",
		os.Getenv("OCP_STATUS_THANOS_URL"),
		"Thanos Querier base URL",
	)

	cmd.Flags().StringVar(
		&thanosToken,
		"thanos-token",
		os.Getenv("OCP_STATUS_THANOS_TOKEN"),
		"Thanos bearer token; prefer environment variable",
	)

	cmd.Flags().StringVar(
		&agentVersion,
		"agent-version",
		"0.1.0",
		"Agent version",
	)

	cmd.Flags().StringVar(
		&kubeconfig,
		"kubeconfig",
		os.Getenv("KUBECONFIG"),
		"Local kubeconfig file path",
	)

	return cmd
}


func executeAgentRun(
	ctx context.Context,
	collector func(context.Context, string, string) (payload.Payload, error),
	computeToken func([]byte, string) (string, error),
	httpClient *http.Client,
	clusterID string,
	agentVersion string,
	collectorURL string,
	key []byte,
) error {
	if strings.TrimSpace(clusterID) == "" {
		return fmt.Errorf("cluster ID is required")
	}
	if len(key) == 0 {
		return fmt.Errorf("HMAC key is required")
	}
	if collector == nil || computeToken == nil {
		return fmt.Errorf("collection and HMAC functions are required")
	}

	endpoint, err := url.Parse(collectorURL)
	if err != nil {
		return fmt.Errorf("invalid collector URL: %w", err)
	}
	if (endpoint.Scheme != "http" &&
		endpoint.Scheme != "https") ||
		endpoint.Host == "" ||
		endpoint.User != nil ||
		endpoint.Fragment != "" {
		return fmt.Errorf("invalid collector URL")
	}

	result, err := collector(ctx, clusterID, agentVersion)
	if err != nil {
		return fmt.Errorf("collect cluster status: %w", err)
	}
	if result.ClusterID != clusterID {
		return fmt.Errorf("payload cluster ID mismatch")
	}


	token, err := computeToken(key, clusterID)
	if err != nil {
		return fmt.Errorf("compute HMAC: %w", err)
	}
	if token == "" {
		return fmt.Errorf("computed HMAC token is empty")
	}

	body, err := json.Marshal(result)
	if err != nil {
		return fmt.Errorf("marshal payload: %w", err)
	}


	req, err := http.NewRequestWithContext(
		ctx,
		http.MethodPost,
		endpoint.String(),
		bytes.NewReader(body),
	)
	if err != nil {
		return fmt.Errorf("create HTTP request: %w", err)
	}

	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("X-Cluster-ID", clusterID)
	req.Header.Set("X-Cluster-Token", token)

	if httpClient == nil {
		httpClient = &http.Client{Timeout: 15 * time.Second}
	}

	resp, err := httpClient.Do(req)
	if err != nil {
		return fmt.Errorf("send payload to collector: %w", err)
	}
	defer resp.Body.Close()

	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 4096))

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf(
			"collector returned HTTP %d",
			resp.StatusCode,
		)
	}

	return nil
}


func loadKubernetesConfig(path string) (*rest.Config, error) {
	if path != "" {
		return clientcmd.BuildConfigFromFlags("", path)
	}

	config, err := rest.InClusterConfig()
	if err == nil {
		return config, nil
	}

	rules := clientcmd.NewDefaultClientConfigLoadingRules()
	clientConfig := clientcmd.NewNonInteractiveDeferredLoadingClientConfig(
		rules,
		&clientcmd.ConfigOverrides{},
	)

	return clientConfig.ClientConfig()
}


var runCmd = newRunCommand()
