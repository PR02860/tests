func TestAgentRunMissingConfig(t *testing.T) {
	tests := []struct {
		name       string
		clusterID  string
		url        string
		key        string
		expected   string
	}{
		{
			name:     "missing_cluster",
			url:      "http://localhost:12345",
			key:      "secret",
			expected: "cluster ID is required",
		},
		{
			name:      "missing_url",
			clusterID: "xoicu1",
			key:       "secret",
			expected:  "collector URL is required",
		},
		{
			name:      "missing_key",
			clusterID: "xoicu1",
			url:       "http://localhost:12345",
			expected:  "OCP_STATUS_HMAC_KEY is required",
		},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Setenv("OCP_STATUS_HMAC_KEY", tc.key)

			cmd := newRunCommandWithDeps(runDependencies{
				collectPayload: mockPayload,
			})
			cmd.SetOut(io.Discard)
			cmd.SetErr(io.Discard)
			cmd.SilenceUsage = true
			cmd.SilenceErrors = true

			cmd.SetArgs([]string{
				"--cluster-id", tc.clusterID,
				"--collector-url", tc.url,
			})

			err := cmd.Execute()
			if err == nil ||
				!strings.Contains(err.Error(), tc.expected) {
				t.Fatalf("expected %q, got %v", tc.expected, err)
			}
		})
	}
}


func TestAgentRunCancelledContext(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(
		func(w http.ResponseWriter, r *http.Request) {
			<-r.Context().Done()
		},
	))
	defer server.Close()

	ctx, cancel := context.WithTimeout(
		context.Background(),
		100*time.Millisecond,
	)
	defer cancel()

	err := executeAgentRun(
		ctx,
		mockPayload,
		auth.ComputeToken,
		server.Client(),
		"xoicu1",
		"0.1.0",
		server.URL,
		[]byte("local-test-secret"),
	)

	if err == nil {
		t.Fatal("expected cancellation error")
	}
}
