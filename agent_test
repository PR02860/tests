func mockPayload(
	ctx context.Context,
	clusterID, version string,
) (payload.Payload, error) {
	return payload.Payload{
		ClusterID:    clusterID,
		AgentVersion: version,
		CollectedAt:  time.Now().UTC(),
		Nodes: []payload.Node{
			{
				Name:                "worker-a",
				Ready:               true,
				CPUUsageCores:       2.5,
				CPUCapacityCores:    8,
				MemoryUsageBytes:    8000000000,
				MemoryCapacityBytes: 16000000000,
				PodCount:            95,
				PodCapacity:         250,
			},
		},
		ClusterOperators:   []payload.ClusterOperator{},
		MachineConfigPools: []payload.MachineConfigPool{},
	}, nil
}

func newTestCommand(
	t *testing.T,
	endpoint string,
	deps runDependencies,
) error {
	t.Helper()

	t.Setenv("OCP_STATUS_HMAC_KEY", "local-test-secret")

	cmd := newRunCommandWithDeps(deps)
	cmd.SetOut(io.Discard)
	cmd.SetErr(io.Discard)
	cmd.SilenceUsage = true
	cmd.SilenceErrors = true

	cmd.SetArgs([]string{
		"--cluster-id", "xoicu1",
		"--collector-url", endpoint,
		"--agent-version", "0.1.0",
	})

	return cmd.Execute()
}


func TestAgentRunSuccess(t *testing.T) {
	received := false

	server := httptest.NewServer(http.HandlerFunc(
		func(w http.ResponseWriter, r *http.Request) {
			received = true

			if r.Method != http.MethodPost {
				t.Errorf("expected POST, got %s", r.Method)
			}
			if r.URL.Path != "/api/status" {
				t.Errorf("unexpected path: %s", r.URL.Path)
			}
			if r.Header.Get("Content-Type") != "application/json" {
				t.Error("incorrect content type")
			}
			if r.Header.Get("X-Cluster-ID") != "xoicu1" {
				t.Error("incorrect cluster ID header")
			}

			// Verify the token with the existing HMAC helper.
			err := auth.Verify(
				[]byte("local-test-secret"),
				"xoicu1",
				r.Header.Get("X-Cluster-Token"),
			)
			if err != nil {
				t.Errorf("invalid HMAC token: %v", err)
			}

			var got payload.Payload
			if err := json.NewDecoder(r.Body).Decode(&got); err != nil {
				t.Errorf("decode payload: %v", err)
				return
			}

			if got.ClusterID != "xoicu1" {
				t.Errorf("wrong cluster ID: %s", got.ClusterID)
			}
			if len(got.Nodes) != 1 {
				t.Errorf("expected one node, got %d", len(got.Nodes))
				return
			}

			node := got.Nodes[0]
			if node.CPUUsageCores != 2.5 ||
				node.CPUCapacityCores != 8 ||
				node.MemoryUsageBytes != 8000000000 ||
				node.MemoryCapacityBytes != 16000000000 ||
				node.PodCount != 95 ||
				node.PodCapacity != 250 {
				t.Errorf("incorrect node data: %+v", node)
			}

			w.WriteHeader(http.StatusAccepted)
		},
	))
	defer server.Close()

	err := newTestCommand(
		t,
		server.URL+"/api/status",
		runDependencies{
			collectPayload: mockPayload,
			computeToken:   auth.ComputeToken,
			httpClient:    server.Client(),
		},
	)
	if err != nil {
		t.Fatal(err)
	}
	if !received {
		t.Fatal("collector did not receive payload")
	}
}


func TestAgentRunCollectionError(t *testing.T) {
	deps := runDependencies{
		collectPayload: func(
			ctx context.Context,
			id, version string,
		) (payload.Payload, error) {
			return payload.Payload{},
				errors.New("Kubernetes unavailable")
		},
		computeToken: auth.ComputeToken,
	}

	err := newTestCommand(
		t,
		"http://localhost:12345/api/status",
		deps,
	)

	if err == nil ||
		!strings.Contains(err.Error(), "collect cluster status") {
		t.Fatalf("expected collection error, got %v", err)
	}
}


