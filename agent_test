
package agent

import (
	"bytes"
	"strings"
	"testing"
)

func TestAgentRunHelp(t *testing.T) {
	command := newRunCommand()

	var output bytes.Buffer
	command.SetOut(&output)
	command.SetErr(&output)
	command.SetArgs([]string{"--help"})

	if err := command.Execute(); err != nil {
		t.Fatalf("help command failed: %v", err)
	}

	for _, expected := range []string{
		"--cluster-id",
		"--collector-url",
		"--thanos-url",
		"--kubeconfig",
	} {
		if !strings.Contains(output.String(), expected) {
			t.Errorf("help missing %s", expected)
		}
	}
}

func TestAgentRunRequiresClusterID(t *testing.T) {
	t.Setenv("OCP_STATUS_CLUSTER_ID", "")
	t.Setenv("OCP_STATUS_HMAC_KEY", "test-secret")

	command := newRunCommand()
	command.SetSilenceUsage(true)
	command.SetSilenceErrors(true)

	err := command.Execute()

	if err == nil ||
		!strings.Contains(err.Error(), "cluster ID is required") {
		t.Fatalf("expected missing cluster ID, got %v", err)
	}
}

