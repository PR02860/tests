func TestThanosRequestCancellation(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(
		func(w http.ResponseWriter, r *http.Request) {
			<-r.Context().Done()
		},
	))
	defer server.Close()

	client := &ThanosClient{
		BaseURL:    server.URL,
		HTTPClient: server.Client(),
	}

	ctx, cancel := context.WithTimeout(
		context.Background(),
		100*time.Millisecond,
	)
	defer cancel()

	_, err := client.Query(ctx, "up")
	if err == nil {
		t.Fatal("expected timeout or cancellation error")
	}
}

// TEST 9: Combined Kubernetes + Thanos collection.
func TestThanosCombinedPayload(t *testing.T) {
	node := &unstructured.Unstructured{
		Object: map[string]interface{}{
			"apiVersion": "v1",
			"kind":       "Node",
			"metadata": map[string]interface{}{
				"name": "worker-a",
				"labels": map[string]interface{}{
					"node-role.kubernetes.io/worker": "",
				},
			},
			"status": map[string]interface{}{
				"conditions": []interface{}{
					map[string]interface{}{
						"type":   "Ready",
						"status": "True",
					},
				},
			},
		},
	}

	k8sClient := fake.NewSimpleDynamicClientWithCustomListKinds(
		runtime.NewScheme(),
		map[schema.GroupVersionResource]string{
			nodesGVR:     "NodeList",
			operatorsGVR: "ClusterOperatorList",
			mcpsGVR:      "MachineConfigPoolList",
		},
		node,
	)

	server := httptest.NewServer(testMetricHandler(t))
	defer server.Close()

	thanosClient := &ThanosClient{
		BaseURL:    server.URL,
		HTTPClient: server.Client(),
	}

	result, err := CollectWithThanos(
		context.Background(),
		k8sClient,
		thanosClient,
		"xoicu1",
		"0.1.0",
	)
	if err != nil {
		t.Fatal(err)
	}

	if result.ClusterID != "xoicu1" {
		t.Errorf("unexpected cluster ID: %s", result.ClusterID)
	}

	if len(result.Nodes) != 1 {
		t.Fatalf("expected 1 node, got %d", len(result.Nodes))
	}

	got := result.Nodes[0]
	if got.CPUUsageCores != 2.5 ||
		got.CPUCapacityCores != 8 ||
		got.MemoryUsageBytes != 8000000000 ||
		got.PodCount != 95 ||
		got.PodCapacity != 250 {
		t.Errorf("combined node metrics incorrect: %+v", got)
	}

	if result.MachineConfigPools == nil {
		t.Error("expected non-nil MCP array")
	}

	if result.CollectedAt.IsZero() {
		t.Error("missing collection timestamp")
	}
}
